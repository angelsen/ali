# ALI Integration for tmux
# Installation: Add to ~/.tmux.conf:
#   source-file ~/.config/ali/tmux.conf.ali
# Or copy this content to ~/.tmux.conf

# ALI Command Prompt
# Usage: C-b a → Enter ALI command
# Example: GO .2, SPLIT left, WIDTH 012
# The input travels via @ali_in: interpolating %% into the shell command
# re-parses quotes, $ and backticks, and tmux expands #{...} in it.
bind-key a command-prompt -p "ALI> " \
  "set -g @ali_in '%%' ; \
  run-shell 'cd #{pane_current_path} && \
    export \
    TMUX_PANE=#{pane_id} \
    TMUX_WINDOW=#{window_id} \
    TMUX_SESSION=#{session_name} && \
    ali \"$(tmux show -gqv @ali_in)\" | sh | sh'"